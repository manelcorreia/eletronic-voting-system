# pra usar SQLite local:
# DATABASE_URL=sqlite:///nome_base_dados

# Se quiseres mudar para MySQL mais tarde, basta comentar a linha de cima e descomentar esta:
# DATABASE_URL=mysql+pymysql://root:password123@localhost:3306/nome_base_dados

# DATABASE_URL=postgresql+psycopg://postgres:YourPassword@YourLocalHost/nome_base_dados